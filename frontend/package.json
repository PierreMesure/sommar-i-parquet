{
  "name": "sommarpratkompassen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-data": "node -e \"import('node:fs').then(fs => { if(fs.existsSync('../data/episodes.json')) fs.copyFileSync('../data/episodes.json', 'public/episodes.json'); if(fs.existsSync('../data/nlp/topics.json')) fs.copyFileSync('../data/nlp/topics.json', 'public/topics.json'); })\"",
    "prebuild": "npm run sync-data",
    "predev": "npm run sync-data",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "devDependencies": {
    "astro": "^7.1.6"
  }
}
