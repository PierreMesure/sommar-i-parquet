---
const title = "Sommarpratkompassen";
const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith("/") ? base : `${base}/`;
const episodesUrl = `${assetBase}episodes.json`;
const topicsUrl = `${assetBase}topics.json`;
const description = "Utforska över 60 år av Sommar i P1 och hitta ditt nya favorit sommarprat!";
const socialImage = "https://sommarprat.mesu.re/og-image.png";
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="episodes-url" content={episodesUrl} />
    <meta name="topics-url" content={topicsUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Sommarpratkompassen — gröna hörlurar omgivna av sommarblommor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="stylesheet" href={`${assetBase}styles.css`} />
    <script data-goatcounter="https://sommarpratkompassen.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <main class="page-shell">
      <header class="hero">
        <div class="maypole-mark" aria-hidden="true">
          <img src={`${assetBase}logo.webp`} alt="" width="320" height="320" />
        </div>
        <div class="hero-copy">
          <h1>Sommarprat<span class="title-break">kompassen</span></h1>
          <p class="intro">
            Hitta ett program att lyssna på — från de tidigaste sändningarna till idag.
          </p>
          <p class="disclaimer">Skapad av <a href="https://pierre.mesu.re" target="_blank" rel="noreferrer">Pierre Mesure</a>, ingen koppling till Sveriges Radio</p>
        </div>
      </header>

      <section aria-label="Filtrera program">
        <div class="filters-heading">
          <h2 class="filters-title">Filter per</h2>
          <button id="filters-toggle" class="filters-toggle" type="button" aria-expanded="true" aria-controls="filters">Dölj filter</button>
        </div>
        <div id="filters" class="filters">
        <fieldset class="filter-group">
          <legend>Avsnitt</legend>
          <div class="filter-fields">
            <label class="search-field" for="search">
              <span>Sök i beskrivningar</span>
              <input
                id="search"
                type="search"
                placeholder="Sök efter ord eller fraser"
                autocomplete="off"
              />
            </label>
            <label for="program-type">
              <span>Program</span>
              <select id="program-type">
                <option value="">Sommar och Vinter</option>
                <option value="Sommar">Sommar</option>
                <option value="Vinter">Vinter</option>
              </select>
            </label>
            <fieldset class="year-range">
              <legend>År</legend>
              <div class="year-range-values"><output id="year-from-output"></output><span>–</span><output id="year-to-output"></output></div>
              <div class="year-range-inputs">
                <input id="year-from" type="range" aria-label="Från år" />
                <input id="year-to" type="range" aria-label="Till år" />
              </div>
            </fieldset>
            <label class="checkbox-filter" for="listeners-host">
              <input id="listeners-host" type="checkbox" />
              <span>Lyssnarnas sommarvärd</span>
            </label>
          </div>
        </fieldset>
        <fieldset class="filter-group">
          <legend>Värd</legend>
          <div class="filter-fields">
            <label for="gender">
              <span>Kön</span>
              <select id="gender"><option value="">Alla</option></select>
            </label>
            <label for="citizenship">
              <span>Medborgarskap</span>
              <select id="citizenship"><option value="">Alla</option></select>
            </label>
            <label for="occupation">
              <span>Sysselsättning</span>
              <select id="occupation"><option value="">Alla</option></select>
            </label>
            <fieldset class="age-range">
              <legend>Ålder vid programmet</legend>
              <div class="age-range-values"><output id="age-from-output"></output><span>–</span><output id="age-to-output"></output></div>
              <div class="age-range-inputs">
                <input id="age-from" type="range" aria-label="Från ålder" />
                <input id="age-to" type="range" aria-label="Till ålder" />
              </div>
            </fieldset>
            <label class="checkbox-filter" for="returning">
              <input id="returning" type="checkbox" />
              <span>Återkommande värdar</span>
            </label>
          </div>
        </fieldset>
        <fieldset id="content-filters" class="filter-group filter-group-disabled" disabled>
          <legend>Innehåll</legend>
          <div class="filter-fields">
            <label for="theme">
              <span data-role="theme-label">Övergripande tema</span>
              <select id="theme" multiple size="5" aria-describedby="topic-selection-help"></select>
            </label>
            <label for="topic">
              <span data-role="topic-label">Specifikt ämne</span>
              <select id="topic" multiple size="7" aria-describedby="topic-selection-help"></select>
            </label>
            <p id="topic-selection-help" class="filter-coming-soon">Teman och ämnen bygger på semantiska likheter som beräknats av AI-modeller från Kungliga biblioteket. Ämnen med svag koppling till programmet bör därför tolkas med viss försiktighet.</p>
          </div>
        </fieldset>
        <div class="filter-actions">
          <label for="sort">
            <span>Sortera</span>
            <select id="sort">
              <option value="newest">Nyast först</option>
              <option value="oldest">Äldst först</option>
              <option value="speaker">Värd A–Ö</option>
              <option value="age-youngest">Ålder, yngst först</option>
              <option value="age-oldest">Ålder, äldst först</option>
              <option value="topic-match">Störst ämnesfokus först</option>
            </select>
          </label>
          <button id="map-toggle" class="map-toggle" type="button" aria-expanded="false">
            <svg class="mdi-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5.1 9 3 3 5.1v14.8l6-2.1 6 2.1 6-2.1V3l-6 2.1Zm0 12.65-6-2.1V5.25l6 2.1v10.4Zm4-1.3-2 .7V6.65l2-.7v10.5Z" /></svg>
            <span data-role="map-label">Semantisk karta</span>
          </button>
        </div>
        <div id="map-drawer" class="map-drawer" hidden>
          <div class="map-panel">
            <canvas id="episode-map" aria-label="Karta över programmens innehåll"></canvas>
          </div>
        </div>
        </div>
      </section>

      <section id="archive-view" class="results" aria-live="polite">
        <div class="results-heading">
          <p id="result-count">Laddar program …</p>
          <button id="reset" class="reset" type="button" hidden>Rensa filter</button>
        </div>
        <div id="episode-list" class="episode-list"></div>
        <p id="empty-state" class="empty-state" hidden>Inga program matchar dina filter.</p>
      </section>

    </main>
    <template id="episode-template">
      <article class="episode-card">
        <div class="episode-image-link" data-role="episode-open" role="button" tabindex="0" aria-label="Visa programdetaljer">
          <img data-role="image" alt="" loading="lazy" />
          <span class="image-fallback" aria-hidden="true"></span>
        </div>
        <div class="episode-content">
          <div class="episode-meta">
            <span data-role="program-type"></span>
            <span data-role="date"></span>
            <span data-role="duration"></span>
          </div>
          <h2><button class="episode-open" data-role="episode-open" type="button"><span data-role="speakers"></span></button></h2>
          <div class="episode-footer">
            <div class="episode-actions">
              <button class="details-toggle" data-role="details-toggle" type="button">Detaljer v</button>
              <a class="listen-link" data-role="listen-link" target="_blank" rel="noreferrer">Lyssna <span aria-hidden="true">→</span></a>
            </div>
            <div data-role="topic-tags" class="topic-tags"></div>
          </div>
        </div>
      </article>
    </template>
    <script type="module" src={`${assetBase}app.js`}></script>
  </body>
</html>
